{
  "name": "estudiemos",
  "private": true,
  "description": "Estudiemos: clases particulares (profe y estudiantes). La app es HTML/JS sin build; esto es solo para el notificador y los tests.",
  "scripts": {
    "test": "node tests/run-tests.mjs",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-estudiemos \"node tests/reglas.test.mjs\"",
    "notificador:seco": "node scripts/notificador.mjs --seco",
    "test:ui": "node tests/ui/ui.test.mjs"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "puppeteer-core": "^23.11.1"
  }
}
